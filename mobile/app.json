{
  "expo": {
    "name": "HealthMate AI",
    "slug": "healthmate-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "healthmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0EA5A4",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthmate.ai",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.healthmate.ai",
      "adaptiveIcon": {
        "backgroundColor": "#0EA5A4"
      },
      "permissions": ["NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"]
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0EA5A4"
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
